{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "rootDir": "src",
    "outDir": "site",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": false,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": ["src/site.ts", "src/translit.ts"]
}
